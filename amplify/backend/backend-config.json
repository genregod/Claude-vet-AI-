{
  "auth": {
    "claudevetai": {
      "service": "Cognito",
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation",
      "dependsOn": [],
      "customAuth": false
    }
  },
  "function": {
    "chatbot": {
      "build": true,
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation",
      "service": "Lambda",
      "dependsOn": [
        {
          "category": "storage",
          "resourceName": "chathistory",
          "attributes": ["Name", "Arn"]
        }
      ]
    }
  },
  "storage": {
    "chathistory": {
      "service": "DynamoDB",
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation"
    },
    "userprofiles": {
      "service": "DynamoDB",
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation"
    },
    "documents": {
      "service": "DynamoDB",
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation"
    },
    "claudevetaidocs": {
      "service": "S3",
      "providerPlugin": "@aws-amplify/cli-plugin-provider-awscloudformation"
    }
  }
}
