{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda function for Claude chatbot with Bedrock integration",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "chathistoryName": {
      "Type": "String"
    },
    "chathistoryArn": {
      "Type": "String"
    }
  },
  "Resources": {
    "LambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "chatbot-${env}"
        },
        "Handler": "index.handler",
        "Runtime": "nodejs18.x",
        "Timeout": 30,
        "MemorySize": 256,
        "Environment": {
          "Variables": {
            "ENV": {
              "Ref": "env"
            },
            "CHAT_HISTORY_TABLE": {
              "Ref": "chathistoryName"
            }
          }
        },
        "Role": {
          "Fn::GetAtt": ["LambdaExecutionRole", "Arn"]
        }
      }
    },
    "LambdaExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyName": "DynamoDBAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Ref": "chathistoryArn"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "BedrockAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": "arn:aws:bedrock:*::foundation-model/anthropic.*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "LambdaFunction"
      }
    },
    "FunctionArn": {
      "Value": {
        "Fn::GetAtt": ["LambdaFunction", "Arn"]
      }
    },
    "LambdaExecutionRole": {
      "Value": {
        "Ref": "LambdaExecutionRole"
      }
    }
  }
}
