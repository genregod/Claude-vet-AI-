# ── Stage 1: Build React + TypeScript + Vite app ────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.js ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./
COPY components.json ./

# Install dependencies
RUN npm ci --only=production=false

# Copy source code
COPY index.html ./
COPY src/ ./src/

# Build the app
RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────────────────
FROM nginx:alpine

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy static config as fallback, then template for envsubst at runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template

# Expose port 80
EXPOSE 80

# Default backend URL for docker-compose local development
ENV BACKEND_URL=backend:8000

# At runtime, substitute BACKEND_URL in the template (leaving nginx vars intact),
# validate the config, then start nginx
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_URL}' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -t && nginx -g 'daemon off;'"]
